[Unit]
Description=Solstice Panel Web (tunnel mode, production build)
After=network-online.target solstice-api.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
Environment=HOME=/var/lib/solstice
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npm run preview --workspace @solstice/web -- --host 127.0.0.1 --port __WEB_PORT__
Restart=always
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
