[Unit]
Description=Solstice Panel API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__/apps/api
EnvironmentFile=/etc/solstice/api.env
Environment=HOME=/var/lib/solstice
ExecStart=/usr/bin/node src/index.ts
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/solstice

[Install]
WantedBy=multi-user.target
