# Production frontend: static build + /api reverse proxy (websockets included).
# Managed by install.sh --domain; do not edit by hand.
__DOMAIN__ {
	encode gzip

	# API (REST + console websockets + uploads).
	handle /api/* {
		reverse_proxy 127.0.0.1:__API_PORT__
	}

	# Built SPA with client-side routing.
	handle {
		root * __APP_DIR__/apps/web/dist
		try_files {path} /index.html
		file_server
	}
}
