[Unit]
Description=Solstice quick tunnel (public URL sync)
After=network-online.target solstice-api.service solstice-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=/bin/bash /usr/local/bin/solstice-tunnel.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
