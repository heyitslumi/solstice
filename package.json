{
  "name": "solstice-host",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @solstice/web",
    "dev:api": "npm run dev --workspace @solstice/api",
    "dev:all": "npm run dev:api & npm run dev",
    "build": "npm run build --workspace @solstice/web",
    "lint": "npm run lint --workspace @solstice/web",
    "test": "npm run test --workspace @solstice/api",
    "typecheck": "npm run build --workspace @solstice/web && tsc -p apps/api/tsconfig.json",
    "build:landing": "npm run build --workspace @solstice/landing && node scripts/check-landing.mjs",
    "deploy:landing": "npm run build:landing && cd apps/landing && npx wrangler deploy"
  },
  "devDependencies": {
    "agentation-mcp": "^1.2.0"
  }
}
